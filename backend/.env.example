# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# OR for deployment (paste JSON as single line):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Groq
GROQ_API_KEY=gsk_...

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Admin UID (optional — your Firebase UID for /admin endpoints)
ADMIN_UID=your_firebase_uid_here

# Phase 2 PostgreSQL: configure privately before calling /api/v2 routes.
# DATABASE_URL=postgresql+psycopg://chronomind:local_password@localhost:5432/chronomind

# Optional V2 LLM routing and price estimates (rates in USD per million tokens)
CHRONOMIND_FAST_LLM_MODEL=llama-3.1-8b-instant
CHRONOMIND_REASONING_LLM_MODEL=llama-3.3-70b-versatile
# CHRONOMIND_INPUT_USD_PER_MILLION=
# CHRONOMIND_OUTPUT_USD_PER_MILLION=
