# ChronoMind V2 backend environment template — never commit your populated .env.
# Copy this file to backend/.env. The app and Alembic load that file when run from backend/.
CHRONOMIND_ENVIRONMENT=development
CHRONOMIND_DISABLE_LEGACY_SCHEDULER=1
LANGGRAPH_STRICT_MSGPACK=true

# Required for V2 data (create disposable local PostgreSQL before enabling):
DATABASE_URL=postgresql+psycopg://chronomind:CHANGE_ME_LOCAL_ONLY@localhost:5432/chronomind

# Firebase Admin. Use one method; never commit the private JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Groq — only required for live natural language and semantic decomposition.
# Without it the deterministic planner and safe assistant fallback remain usable.
GROQ_API_KEY=

# CORS: exact browser origin(s), no wildcard.
CORS_ORIGINS=http://localhost:5173

# Optional: explicit server-side admin Firebase UID (never a dummy wildcard).
# ADMIN_UID=

# Allowlisted Groq models; verify access with your account when resuming.
CHRONOMIND_LLM_FAST_MODEL=llama-3.1-8b-instant
CHRONOMIND_LLM_REASONING_MODEL=llama-3.3-70b-versatile

# Optional cost estimates; rates provided by the operator, NOT guessed.
# CHRONOMIND_INPUT_USD_PER_MILLION=
# CHRONOMIND_OUTPUT_USD_PER_MILLION=

# These must remain off until dedicated jobs are tested and deployed.
CHRONOMIND_NOTIFICATIONS_JOB_ENABLED=0
CHRONOMIND_RECURRENCE_JOB_ENABLED=0
CHRONOMIND_REPLAN_JOB_ENABLED=0

# Explicitly set to 1 ONLY to seed fixtures on a disposable localhost database.
CHRONOMIND_DEMO_SEED_ENABLED=0
