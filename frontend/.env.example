# Copy to frontend/.env.local. These Firebase Web config identifiers are not Admin secrets.
# Never put GROQ_API_KEY, DATABASE_URL, or Firebase Admin private keys in VITE_* variables.
VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Set true only after configuring PostgreSQL, applying migrations and enabling V2 backend APIs.
VITE_V2_DEFAULT=true

# /demo is a public, static sample preview; real V2 pages require a Firebase login.
